# Optional build-time defaults: flutter run --dart-define-from-file=.env.json
# The app normally asks for these on first start and keeps them in secure storage.
# Never commit real values. Baking secrets into a build with --dart-define puts
# them inside the APK; use that for local testing only.
TUNNEL_URL=wss://your-worker.your-subdomain.workers.dev
AUTH_TOKEN=change-me-client-token
SERVER_ID=my-server
SSH_USER=administrator
SSH_PASSWORD=
GATEWAY_TOKEN=
